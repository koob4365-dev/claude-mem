# Privacy and transient cloud runtime. This file contains no secret values.
DO_NOT_TRACK=1
CLAUDE_MEM_DATA_DIR=/tmp/claude-mem-runtime
CLAUDE_CONFIG_DIR=/tmp/claude-config
CLAUDE_MEM_WORKER_PORT=38000
CLAUDE_CODE_PATH=/workspace/.local/bin/claude
CLAUDE_MEM_TELEMETRY=0
CLAUDE_MEM_TELEMETRY_ERRORS=0
CLAUDE_MEM_REDACT_ENABLED=true
CLAUDE_MEM_REDACT_GENERIC_ENABLED=true
CLAUDE_MEM_REDACT_LOG_MATCHES=false

# Keep Claude as the default working provider.
CLAUDE_MEM_PROVIDER=claude

# Discover every supported profile and generate a secret-free cloud plan with:
# node cloud-body/providers/providerctl.mjs list
# node cloud-body/providers/providerctl.mjs plan <profile-id>

# OpenAI through the built-in OpenAI-compatible route.
# CLAUDE_MEM_PROVIDER=openai-compatible
# CLAUDE_MEM_OPENAI_COMPAT_PRESET=custom
# CLAUDE_MEM_OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# CLAUDE_MEM_OPENAI_COMPAT_MODEL=<chat-completions-model>
# CLAUDE_MEM_OPENAI_COMPAT_API_KEY=<set-as-cloud-secret>

# Any other OpenAI-compatible endpoint uses the same provider with its own
# allowlisted hostname, model id, and endpoint-issued secret.
# CLAUDE_MEM_OPENAI_COMPAT_BASE_URL=https://gateway.example.com/v1
# CLAUDE_MEM_OPENAI_COMPAT_MODEL=<gateway-model-id>

# Optional alternatives.
# CLAUDE_MEM_PROVIDER=openrouter
# CLAUDE_MEM_OPENROUTER_API_KEY=<set-as-cloud-secret>
# CLAUDE_MEM_PROVIDER=gemini
# CLAUDE_MEM_GEMINI_API_KEY=<set-as-cloud-secret>
# ANTHROPIC_API_KEY=<set-as-cloud-secret>

